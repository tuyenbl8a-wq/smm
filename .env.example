# Core runtime (required from Phase 2 onward)
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://smm:smm_dev_only@localhost:5432/smm?schema=public
REDIS_URL=redis://localhost:6379

# Generate independent values with: openssl rand -base64 48
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=

# Email (optional in local development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Binance Pay merchant integration (optional; feature remains disabled without credentials)
BINANCE_MERCHANT_API_KEY=
BINANCE_MERCHANT_SECRET=
BINANCE_WEBHOOK_SECRET=

# VietQR / supported bank transaction provider (optional)
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
VIETQR_WEBHOOK_SECRET=

# Public bank transfer display (safe to expose; never place webhook secrets here)
BANK_NAME=
BANK_BIN=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Casso bank-feed integration (optional; bank auto-credit is disabled without token)
CASSO_API_KEY=
CASSO_WEBHOOK_SECURE_TOKEN=

# S3-compatible storage (optional; local private storage is the development default)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# Development seed only. Required by `pnpm db:seed`; never reuse in production.
DEV_SEED_ADMIN_EMAIL=
DEV_SEED_ADMIN_USERNAME=superadmin
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_CUSTOMER_EMAIL=
DEV_SEED_CUSTOMER_USERNAME=demo_customer
DEV_SEED_CUSTOMER_PASSWORD=

# Compose PostgreSQL credentials. Local host processes may override DATABASE_URL.
POSTGRES_USER=smm
POSTGRES_PASSWORD=
POSTGRES_DB=smm
