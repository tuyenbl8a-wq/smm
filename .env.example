# Core runtime (required from Phase 2 onward)
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://smm:smm_dev_only@localhost:5432/smm?schema=public
REDIS_URL=redis://localhost:6379

# Generate independent values with: openssl rand -base64 48
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=

# Email (optional in local development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Binance Pay merchant integration (optional; feature remains disabled without credentials)
BINANCE_MERCHANT_API_KEY=
BINANCE_MERCHANT_SECRET=
BINANCE_WEBHOOK_SECRET=

# VietQR / supported bank transaction provider (optional)
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
VIETQR_WEBHOOK_SECRET=

# S3-compatible storage (optional; local private storage is the development default)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

