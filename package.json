{
  "name": "smm-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented SMM panel modular monolith",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm build && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm build && node scripts/dev.mjs",
    "dev:docker": "docker compose up --build",
    "docker:config": "docker compose config --quiet",
    "db:generate": "pnpm --filter @smm/database db:generate",
    "db:validate": "pnpm --filter @smm/database db:validate",
    "db:migrate": "pnpm --filter @smm/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @smm/database db:migrate:deploy",
    "db:seed": "pnpm --filter @smm/database db:seed"
  }
}
