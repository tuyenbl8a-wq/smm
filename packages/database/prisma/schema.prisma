generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  BANNED
  DELETED
}

enum RoleCode {
  USER
  RESELLER
  SUPPORT
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum TransactionType {
  DEPOSIT
  ORDER
  REFUND
  ADMIN_ADD
  ADMIN_SUBTRACT
  AFFILIATE
  BONUS
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELED
  REFUNDED
  FAILED
}

enum DepositStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  FAILED
  MANUAL_REVIEW
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  INACTIVE
}

enum TicketStatus {
  OPEN
  ANSWERED
  CUSTOMER_REPLY
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELED
}

enum RequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  UNKNOWN
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
}

enum PricingMode {
  FIXED
  COST_PLUS_PERCENT
  COST_PLUS_FIXED
  COST_PLUS_PERCENT_AND_FIXED
}

enum PriceSafetyAction {
  AUTO_RAISE
  DISABLE_SERVICE
  REQUIRE_REVIEW
}

enum PriceReviewStatus {
  OK
  PRICE_REVIEW
}

enum PriceAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum PriceAlertStatus {
  OPEN
  RESOLVED
}

enum UpgradeMatchMode {
  ALL
  ANY
}

enum PriceGroupChangeSource {
  MANUAL
  AUTO
}

enum ProviderDisabledPolicy {
  KEEP_ACTIVE
  DISABLE_SERVICE
  REQUIRE_REVIEW
}

enum ProviderSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique @db.VarChar(320)
  username String @unique @db.VarChar(64)
  passwordHash String @map("password_hash") @db.VarChar(255)
  status UserStatus @default(PENDING)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  avatarKey String? @map("avatar_key") @db.VarChar(512)
  priceGroupId String? @map("price_group_id") @db.Uuid
  priceGroupEvaluatedAt DateTime? @map("price_group_evaluated_at") @db.Timestamptz(3)
  referralCode String @unique @map("referral_code") @db.VarChar(32)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([status, createdAt])
  @@index([status, priceGroupEvaluatedAt])
  @@map("users")
}

model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code RoleCode @unique
  name String @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("roles")
}
model Permission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("permissions")
}
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}
model UserPermission {
  userId String @map("user_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  grantedBy String? @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}
model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(128)
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}
model ApiKey {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  keyPrefix String @map("key_prefix") @db.VarChar(16)
  keyHash String @unique @map("key_hash") @db.VarChar(128)
  active Boolean @default(true)
  rateLimit Int @default(60) @map("rate_limit")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([userId, active])
  @@map("api_keys")
}
model Wallet {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  balance Decimal @default(0) @db.Decimal(20, 8)
  currency String @default("USD") @db.Char(3)
  version Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("wallets")
}
model WalletTransaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId String @map("wallet_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  type TransactionType
  amount Decimal @db.Decimal(20, 8)
  balanceBefore Decimal @map("balance_before") @db.Decimal(20, 8)
  balanceAfter Decimal @map("balance_after") @db.Decimal(20, 8)
  referenceId String? @map("reference_id") @db.VarChar(128)
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(128)
  description String? @db.VarChar(500)
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([type, referenceId])
  @@map("wallet_transactions")
}
model PaymentMethod {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.VarChar(50)
  name String @db.VarChar(120)
  providerType String @map("provider_type") @db.VarChar(50)
  configEncrypted String? @map("config_encrypted") @db.Text
  currency String @db.VarChar(10)
  minAmount Decimal @map("min_amount") @db.Decimal(20, 8)
  maxAmount Decimal @map("max_amount") @db.Decimal(20, 8)
  feeFixed Decimal @default(0) @map("fee_fixed") @db.Decimal(20, 8)
  feePercent Decimal @default(0) @map("fee_percent") @db.Decimal(9, 6)
  icon String? @db.VarChar(2048)
  exchangeRate Decimal @default(1) @map("exchange_rate") @db.Decimal(24, 12)
  dailyTransactionLimit Int @default(0) @map("daily_transaction_limit")
  dailyAmountLimit Decimal @default(0) @map("daily_amount_limit") @db.Decimal(20, 8)
  bonusPercent Decimal @default(0) @map("bonus_percent") @db.Decimal(9, 6)
  instructions String? @db.Text
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([active, sortOrder])
  @@map("payment_methods")
}
model Deposit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  paymentMethodId String @map("payment_method_id") @db.Uuid
  code String @unique @db.VarChar(32)
  status DepositStatus @default(PENDING)
  grossAmount Decimal @map("gross_amount") @db.Decimal(20, 8)
  feeAmount Decimal @map("fee_amount") @db.Decimal(20, 8)
  netAmount Decimal @map("net_amount") @db.Decimal(20, 8)
  sourceCurrency String @map("source_currency") @db.VarChar(10)
  baseCurrency String @map("base_currency") @db.Char(3)
  exchangeRate Decimal @map("exchange_rate") @db.Decimal(24, 12)
  bonusRateSnapshot Decimal @default(0) @map("bonus_rate_snapshot") @db.Decimal(9, 6)
  creditedAmount Decimal @map("credited_amount") @db.Decimal(20, 8)
  externalOrderId String? @unique @map("external_order_id") @db.VarChar(128)
  externalTransactionId String? @unique @map("external_transaction_id") @db.VarChar(128)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  paidAt DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("deposits")
}
model PaymentReconciliationJob {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  depositId String @unique @map("deposit_id") @db.Uuid
  provider String @db.VarChar(40)
  status RequestStatus @default(PENDING)
  attempts Int @default(0)
  maxAttempts Int @default(8) @map("max_attempts")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(3)
  claimToken String? @unique @map("claim_token") @db.Uuid
  lastError String? @map("last_error") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([provider, status, nextAttemptAt])
  @@index([status, claimedAt])
  @@map("payment_reconciliation_jobs")
}
model PaymentWebhook {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentMethodId String @map("payment_method_id") @db.Uuid
  externalEventId String @map("external_event_id") @db.VarChar(160)
  signatureValid Boolean @map("signature_valid")
  status RequestStatus @default(PENDING)
  payload Json
  payloadHash String @map("payload_hash") @db.VarChar(128)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  errorCode String? @map("error_code") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([paymentMethodId, externalEventId])
  @@index([status, createdAt])
  @@map("payment_webhooks")
}
model Provider {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(120)
  apiUrl String @map("api_url") @db.VarChar(2048)
  apiKeyEncrypted String @map("api_key_encrypted") @db.Text
  encryptionKeyVersion Int @map("encryption_key_version")
  currency String @db.VarChar(10)
  balance Decimal? @db.Decimal(20, 8)
  status ProviderStatus @default(ACTIVE)
  priority Int @default(100)
  timeoutMs Int @default(15000) @map("timeout_ms")
  maxRetries Int @default(3) @map("max_retries")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(3)
  lastSyncAt DateTime? @map("last_sync_at") @db.Timestamptz(3)
  autoSyncEnabled Boolean @default(false) @map("auto_sync_enabled")
  syncIntervalMinutes Int @default(15) @map("sync_interval_minutes")
  nextSyncAt DateTime? @map("next_sync_at") @db.Timestamptz(3)
  syncClaimedAt DateTime? @map("sync_claimed_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([status, priority])
  @@index([autoSyncEnabled, nextSyncAt])
  @@map("providers")
}
model ProviderService {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  externalId String @map("external_id") @db.VarChar(100)
  name String @db.VarChar(255)
  category String @db.VarChar(255)
  type String @db.VarChar(80)
  rate Decimal @db.Decimal(20, 8)
  min Int
  max Int
  refill Boolean @default(false)
  cancel Boolean @default(false)
  raw Json?
  active Boolean @default(true)
  stale Boolean @default(false)
  lastSyncedAt DateTime @map("last_synced_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([providerId, externalId])
  @@index([providerId, active])
  @@map("provider_services")
}
model Platform {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(120)
  slug String @unique @db.VarChar(140)
  icon String? @db.VarChar(255)
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([active, sortOrder])
  @@map("platforms")
}
model ServiceCategory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformId String? @map("platform_id") @db.Uuid
  name String @db.VarChar(160)
  slug String @unique @db.VarChar(180)
  description String? @db.Text
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(true)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([active, sortOrder])
  @@index([platformId, active, sortOrder])
  @@map("service_categories")
}
model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  name String @db.VarChar(255)
  source String @default("API") @db.VarChar(20)
  description String? @db.Text
  type String @db.VarChar(80)
  pricingModel String @default("PER_THOUSAND") @map("pricing_model") @db.VarChar(40)
  rate Decimal @db.Decimal(20, 8)
  providerCost Decimal @map("provider_cost") @db.Decimal(20, 8)
  pricingMode PricingMode @default(COST_PLUS_PERCENT_AND_FIXED) @map("pricing_mode_strategy")
  defaultMarkupPercent Decimal @default(0) @map("default_markup_percent") @db.Decimal(9, 6)
  defaultFixedProfit Decimal @default(0) @map("default_fixed_profit") @db.Decimal(20, 8)
  defaultMinProfit Decimal @default(0) @map("default_min_profit") @db.Decimal(20, 8)
  autoDecrease Boolean @default(true) @map("auto_decrease")
  safetyAction PriceSafetyAction @default(AUTO_RAISE) @map("safety_action")
  maxAutomaticIncreasePercent Decimal @default(50) @map("max_automatic_increase_percent") @db.Decimal(9, 6)
  priceReviewStatus PriceReviewStatus @default(OK) @map("price_review_status")
  min Int
  max Int
  averageTime String? @map("average_time") @db.VarChar(100)
  refill Boolean @default(false)
  cancel Boolean @default(false)
  restrictFromApi Boolean @default(false) @map("restrict_from_api")
  customFields Json? @map("custom_fields")
  sortOrder Int @default(0) @map("sort_order")
  active Boolean @default(true)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([categoryId, active, sortOrder])
  @@map("services")
}
model ServiceMapping {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  providerServiceId String @map("provider_service_id") @db.Uuid
  priority Int @default(100)
  active Boolean @default(true)
  markupPercent Decimal? @map("markup_percent") @db.Decimal(9, 6)
  fixedProfit Decimal? @map("fixed_profit") @db.Decimal(20, 8)
  minProfit Decimal @default(0) @map("min_profit") @db.Decimal(20, 8)
  syncAll Boolean @default(true) @map("sync_all")
  syncName Boolean @default(true) @map("sync_name")
  syncCost Boolean @default(true) @map("sync_cost")
  syncMin Boolean @default(true) @map("sync_min")
  syncMax Boolean @default(true) @map("sync_max")
  syncType Boolean @default(true) @map("sync_type")
  syncRefill Boolean @default(true) @map("sync_refill")
  syncCancel Boolean @default(true) @map("sync_cancel")
  syncStatus Boolean @default(true) @map("sync_status")
  syncDescription Boolean @default(false) @map("sync_description")
  syncAverageTime Boolean @default(false) @map("sync_average_time")
  providerCostOverride Decimal? @map("provider_cost_override") @db.Decimal(20, 8)
  disabledPolicy ProviderDisabledPolicy @default(REQUIRE_REVIEW) @map("disabled_policy")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([serviceId, providerServiceId])
  @@index([serviceId, active, priority])
  @@map("service_mappings")
}

model ProviderCategoryMapping {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  providerCategory String @map("provider_category") @db.VarChar(255)
  platformId String? @map("platform_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([providerId, providerCategory])
  @@index([categoryId])
  @@map("provider_category_mappings")
}

model ProviderSyncLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String @map("provider_id") @db.Uuid
  status ProviderSyncStatus @default(RUNNING)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  received Int @default(0)
  created Int @default(0)
  updated Int @default(0)
  unchanged Int @default(0)
  stale Int @default(0)
  priceIncreased Int @default(0) @map("price_increased")
  priceDecreased Int @default(0) @map("price_decreased")
  requiresReview Int @default(0) @map("requires_review")
  errors Int @default(0)
  errorMessage String? @map("error_message") @db.VarChar(500)
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([providerId, startedAt])
  @@index([status, startedAt])
  @@map("provider_sync_logs")
}
model Order {
  id BigInt @id @default(autoincrement())
  publicId String @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  providerId String? @map("provider_id") @db.Uuid
  providerOrderId String? @map("provider_order_id") @db.VarChar(128)
  providerSubmitKey String @unique @map("provider_submit_key") @db.VarChar(128)
  link String @db.Text
  quantity Int
  startCount Int? @map("start_count")
  remains Int?
  saleRate Decimal @map("sale_rate") @db.Decimal(20, 8)
  charge Decimal @db.Decimal(20, 8)
  originalCharge Decimal @default(0) @map("original_charge") @db.Decimal(20, 8)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(20, 8)
  couponCode String? @map("coupon_code") @db.VarChar(50)
  priceGroupIdSnapshot String? @map("price_group_id_snapshot") @db.Uuid
  priceGroupCodeSnapshot String? @map("price_group_code_snapshot") @db.VarChar(50)
  providerRate Decimal @map("provider_rate") @db.Decimal(20, 8)
  providerCost Decimal @map("provider_cost") @db.Decimal(20, 8)
  profit Decimal @db.Decimal(20, 8)
  status OrderStatus @default(PENDING)
  input Json?
  refundedAmount Decimal @default(0) @map("refunded_amount") @db.Decimal(20, 8)
